# Copia este archivo como .env.local y rellena los valores de tu app web de Firebase
# (Configuración del proyecto → Tus apps → app web). Sin ellos, la app funciona solo en local.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=

# Clave del sitio de reCAPTCHA Enterprise ("Fraud Defense") para Firebase App Check. Sin ella, App Check no se activa.
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
