rules_version = '2';

// Reglas de seguridad de 2Budget.
// Hace falta haber verificado el email para leer o escribir cualquier cosa.
// Cada usuario solo ve su perfil y el hogar del que es miembro (como mucho 2 miembros).
// Para unirse a un hogar hace falta un código de invitación válido de ese hogar.
// Los datos (transacciones, informes y configuración) van cifrados en el navegador: aquí solo
// se controla quién puede leer y escribir los documentos cifrados.
// Todo se valida aquí: no hay Cloud Functions (exigirían el plan de pago Blaze).
service cloud.firestore {
  match /databases/{database}/documents {

    // Sesión iniciada y email verificado: sin verificar no se puede tocar nada de la nube.
    function signedIn() {
      return request.auth != null && request.auth.token.email_verified == true;
    }

    function householdData(hid) {
      return get(/databases/$(database)/documents/households/$(hid)).data;
    }

    function isMember(hid) {
      return signedIn() && request.auth.uid in householdData(hid).members;
    }

    // Miembro tras la escritura en curso: al crear el hogar, el hogar y la clave del creador
    // van en el mismo lote, y `get()` aún no ve el hogar.
    function isMemberAfter(hid) {
      return signedIn()
        && request.auth.uid in getAfter(/databases/$(database)/documents/households/$(hid)).data.members;
    }

    // Unirse con invitación: el usuario solo puede añadirse a sí mismo como Persona 2,
    // a un hogar que tiene un único miembro, citando un código vigente de ese mismo hogar.
    function isValidJoin(hid) {
      let before = resource.data;
      let after = request.resource.data;
      let invite = get(/databases/$(database)/documents/invites/$(after.joinCode)).data;
      return signedIn()
        && !(request.auth.uid in before.members)
        && before.members.size() == 1
        && after.members == before.members.concat([request.auth.uid])
        && after.diff(before).affectedKeys().hasOnly(['members', 'roles', 'memberEmails', 'joinCode'])
        && after.roles.diff(before.roles).affectedKeys().hasOnly([request.auth.uid])
        && after.roles[request.auth.uid] == 'person2'
        && after.memberEmails.diff(before.memberEmails).affectedKeys().hasOnly([request.auth.uid])
        && invite.householdId == hid
        && invite.expiresAt > request.time
        // La invitación se gasta en la misma escritura (3.0.3): no se puede reutilizar.
        && !existsAfter(/databases/$(database)/documents/invites/$(after.joinCode));
    }

    // Lo que un miembro puede cambiar en el hogar (3.0.3). Antes bastaba con no añadir miembros,
    // y un miembro podía quitar al otro, intercambiar roles o dejar el hogar sin nadie.
    function isMemberUpdate() {
      let before = resource.data;
      let after = request.resource.data;
      let changed = after.diff(before).affectedKeys();
      return signedIn()
        && request.auth.uid in before.members
        && (
          // Los datos cifrados (configuración) y la versión mínima de la app.
          changed.hasOnly(['enc', 'minAppVersion'])
          // Su propio email.
          || (changed.hasOnly(['memberEmails'])
            && after.memberEmails.diff(before.memberEmails).affectedKeys().hasOnly([request.auth.uid]))
          // Salir: se quita a sí mismo, con su rol y su email; el otro miembro se queda.
          || (changed.hasOnly(['members', 'roles', 'memberEmails'])
            && before.members.size() == 2
            && after.members == before.members.removeAll([request.auth.uid])
            && after.roles.diff(before.roles).affectedKeys().hasOnly([request.auth.uid])
            && !(request.auth.uid in after.roles)
            && after.memberEmails.diff(before.memberEmails).affectedKeys().hasOnly([request.auth.uid])
            && !(request.auth.uid in after.memberEmails))
        );
    }

    // Perfil: solo su dueño.
    match /users/{uid} {
      allow read, write: if signedIn() && request.auth.uid == uid;
    }

    match /households/{hid} {
      allow read: if signedIn() && request.auth.uid in resource.data.members;

      // Se crea con el usuario como único miembro.
      allow create: if signedIn()
        && request.resource.data.members == [request.auth.uid]
        && request.resource.data.createdBy == request.auth.uid;

      // Un miembro solo cambia lo que permite `isMemberUpdate` (datos cifrados, su email o salir).
      // Un no miembro solo puede unirse con invitación.
      allow update: if isMemberUpdate() || isValidJoin(hid);

      // Solo se borra cuando lo deja el último miembro.
      allow delete: if signedIn()
        && resource.data.members == [request.auth.uid];

      match /transactions/{transactionId} {
        allow read, write: if isMember(hid);
      }

      match /reports/{reportId} {
        allow read, write: if isMember(hid);
      }

      // Clave del hogar envuelta con la contraseña maestra de cada miembro: solo la suya.
      match /keys/{memberId} {
        allow read: if request.auth.uid == memberId && isMember(hid);
        allow create, update: if request.auth.uid == memberId && isMemberAfter(hid);
        allow delete: if request.auth.uid == memberId && isMember(hid);
      }

      // Clave del hogar envuelta con el código de recuperación de cada miembro: solo la suya.
      match /recovery/{memberId} {
        allow read: if request.auth.uid == memberId && isMember(hid);
        allow create, update: if request.auth.uid == memberId && isMemberAfter(hid);
        allow delete: if request.auth.uid == memberId && isMember(hid);
      }
    }

    // Invitaciones: se leen por código (sin poder listarlas) y las crea un miembro del hogar, con
    // caducidad de 48 horas como mucho. Las borra un miembro, o quien se une en la misma escritura.
    match /invites/{code} {
      allow get: if signedIn();
      allow create: if signedIn()
        && request.resource.data.createdBy == request.auth.uid
        && isMember(request.resource.data.householdId)
        && request.resource.data.expiresAt > request.time
        && request.resource.data.expiresAt < request.time + duration.value(49, 'h');
      allow delete: if isMember(resource.data.householdId) || isMemberAfter(resource.data.householdId);
    }
  }
}
